# PostgreSQL (matches docker-compose postgres service)
DATABASE_URL=postgresql://powerbi_agent:powerbi_agent@127.0.0.1:5433/powerbi_agent

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Langfuse (optional — skip gracefully when unset)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# Backend seed demo data on startup
SEED_ON_STARTUP=true
